{
  "name": "w3-10-reference-game",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.2"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.json && node --test tests/evaluation.test.mjs tests/signals.test.mjs",
    "test:all": "tsc -p tsconfig.json && node --test tests/*.test.mjs",
    "fixtures": "tsc -p tsconfig.json && node scripts/verify-fixtures.mjs",
    "serve": "tsc -p tsconfig.json && node dist/server.js --port 4310"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "5.9.3"
  }
}
